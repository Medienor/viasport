{
  "name": "viasport-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prefetch-players": "npx ts-node-esm --project tsconfig.scripts.json scripts/fetchNorwegianPlayers.ts",
    "prefetch-teams": "node scripts/fetchLeagueTeams.js",
    "prefetch-calendar": "npx tsx scripts/fetchCalendarData.ts",
    "prefetch-leagues": "node scripts/fetchLeaguesData.js",
    "prefetch-top-players": "node scripts/fetchTopPlayersData.js",
    "generate-search-index": "node scripts/generateSearchIndex.js",
    "dev": "npm run prefetch-teams && npm run prefetch-calendar && npm run prefetch-leagues && npm run prefetch-top-players && npm run generate-search-index && next dev --turbopack",
    "prebuild": "npm run prefetch-teams && npm run prefetch-calendar && npm run prefetch-leagues && npm run prefetch-top-players && npm run generate-search-index",
    "build": "set DEBUG=* && set NEXT_DEBUG_BUILD=true && next build --no-lint --debug",
    "start": "next start",
    "lint": "next lint",
    "update-teams": "tsx src/scripts/manualUpdate.ts",
    "update-fixtures": "tsx src/scripts/manualFixtureUpdate.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.68.0",
    "@types/react-datepicker": "^6.2.0",
    "ansi-colors": "^4.1.3",
    "axios": "^1.8.4",
    "chart.js": "^4.4.8",
    "cli-progress": "^3.12.0",
    "colorthief": "^2.6.0",
    "cross-fetch": "^4.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.7.4",
    "fuse.js": "^7.1.0",
    "next": "15.1.7",
    "next-seo": "^6.6.0",
    "node-fetch": "^3.3.2",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-countup": "^6.5.3",
    "react-datepicker": "^8.3.0",
    "react-dom": "^19.0.0",
    "react-tooltip": "^5.28.1",
    "recharts": "^2.15.3",
    "ts-node": "^10.9.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.17.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "supabase": "^2.20.12",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
